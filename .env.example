# AnchorSense AI — Environment Variables Reference

# ---------------------------------------------------------------------------
# Frontend (Vercel) Environment Variables
# ---------------------------------------------------------------------------
# Public HTTPS URL of the deployed FastAPI positioning engine.
# In local development, the API defaults to http://127.0.0.1:8000 when unset.
VITE_API_BASE_URL=https://anchorsense-api.onrender.com

# ---------------------------------------------------------------------------
# Backend (Render / Python Web Service) Environment Variables
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# Local development origins (localhost:5173, etc.) are always included.
ALLOWED_ORIGINS=https://locentra.vercel.app,https://anchorsense-ai.vercel.app
